# Database paths — choose ONE based on environment:
#
# Development: file in project root, used for local iteration and testing
# DATABASE_URL=sqlite:///./dev.db
#
# Production: managed by systemd cron (sector-flow ingest + sector-flow analyze)
# DATABASE_URL=sqlite:////home/rippere/.sector_flow/sector_flow.db
#
# Docker: mounted as a volume, set automatically by docker-compose.yml
# DATABASE_URL=sqlite:////data/sector_flow.db  (set by docker-compose.yml)
DATABASE_URL=sqlite:///./dev.db

API_HOST=0.0.0.0
API_PORT=8000
DATA_REFRESH_INTERVAL=3600
LOG_LEVEL=INFO
