[Unit]
Description=Sector Flow Analyzer — intraday price refresh + signal recompute (RTH only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/external/Projects/sector-flow-analyzer
Environment="HOME=/home/rippere"
Environment="PYTHONUNBUFFERED=1"
Environment="DATABASE_URL=sqlite:////home/rippere/.sector_flow/sector_flow.db"
UnsetEnvironment=CLAUDECODE
# `intraday` no-ops on its own when the market is closed, so firing slightly
# outside RTH (see the timer) is harmless.
ExecStart=/mnt/external/Projects/sector-flow-analyzer/.venv/bin/sector-flow intraday
StandardOutput=append:/home/rippere/.sector_flow/logs/cron.log
StandardError=append:/home/rippere/.sector_flow/logs/cron.log
