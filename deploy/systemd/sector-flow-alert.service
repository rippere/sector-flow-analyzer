[Unit]
Description=Sector Flow Analyzer — daily signal alert (writes to Alfred inbox on signal)
After=sector-flow-analyze.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/external/Projects/sector-flow-analyzer
Environment="HOME=/home/rippere"
Environment="PYTHONUNBUFFERED=1"
Environment="DATABASE_URL=sqlite:////home/rippere/.sector_flow/sector_flow.db"
UnsetEnvironment=CLAUDECODE
ExecStart=/mnt/external/Projects/sector-flow-analyzer/.venv/bin/python /mnt/external/Projects/sector-flow-analyzer/deploy/sector-flow-alert.py
StandardOutput=append:/home/rippere/.sector_flow/logs/cron.log
StandardError=append:/home/rippere/.sector_flow/logs/cron.log
