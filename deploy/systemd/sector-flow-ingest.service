[Unit]
Description=Sector Flow Analyzer — daily data ingestion (OHLCV + SSGA flow snapshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/external/Projects/sector-flow-analyzer
Environment="HOME=/home/rippere"
Environment="PYTHONUNBUFFERED=1"
Environment="DATABASE_URL=sqlite:////home/rippere/.sector_flow/sector_flow.db"
UnsetEnvironment=CLAUDECODE
ExecStart=/mnt/external/Projects/sector-flow-analyzer/.venv/bin/sector-flow ingest
StandardOutput=append:/home/rippere/.sector_flow/logs/cron.log
StandardError=append:/home/rippere/.sector_flow/logs/cron.log
